{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PawnDesk",
  "version": "1.0.1",
  "identifier": "com.pawndesk.desktop",
  "build": {
    "frontendDist": "splash",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/pawndesk-api"],
    "resources": [
      "resources/package.json",
      "resources/dist",
      "resources/migrations",
      "binaries/*.node"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDMUE2NDY2NjMwODIxNTcKUldSWElRaGpabVFhZkdNZ2Uza3Z2dmowejJrMVpwbGNZZ210M3pZY1pTUllWcnM3S1EzSTVxaGsK",
      "endpoints": [
        "https://github.com/SarathDeveloper/adagu/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
