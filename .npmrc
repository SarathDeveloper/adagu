# better-sqlite3 ships prebuilt binaries (prebuilds/) and loads those first,
# but npm still runs `node-gyp rebuild` for it on install. That compile needs
# Visual Studio and fails on runners whose node-gyp does not recognise the
# installed version. No other dependency needs its install script: esbuild finds
# its platform package without one, and core-js only prints a banner.
# `npm run <script>` is unaffected.
ignore-scripts=true
